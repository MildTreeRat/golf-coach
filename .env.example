# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it must never carry a
# real value. Everything here is optional — `src/golf_coach/config.py` holds the defaults and is
# the only module in the repo that reads the environment. The `GOLF_` prefix is not optional.
#
# Fill these in with an editor, not `echo "..." >> .env`. On Windows, PSReadLine records every
# command you type into a plaintext history file that survives reboots, so `echo` leaves a copy
# of the secret somewhere you will not think to clear.

# --- Secrets -----------------------------------------------------------------------------
# Both are typed `SecretStr` in config.py, so they render as `**********` in logs, reprs and
# tracebacks; reading one takes a deliberate `.get_secret_value()` (see ADR-019).

# Shared secret for phone uploads (ADR-016). Generate one with:
#     python -c 'import secrets; print(secrets.token_urlsafe(24))'
# `scripts/run_server.py` refuses a non-loopback bind without it, because `/api/uploads` has no
# other authentication.
GOLF_UPLOAD_TOKEN=

# Anthropic key for the written coaching (M6). Genuinely optional: with no key the pipeline
# skips the call, records why in `notes`, and the swing still scores — nobody is billed for
# installing the repo. Needs the `llm` extra.
GOLF_ANTHROPIC_API_KEY=

# --- Common overrides --------------------------------------------------------------------
# Uncomment only what you are actually changing; the defaults in config.py are the real ones.

# GOLF_COACHING_ENABLED=false     # run the pipeline without coaching even with a key configured
# GOLF_ANALYSIS_ENABLED=false     # pure ingestion; drive scripts/analyze_bundle.py by hand
# GOLF_API_PORT=3000              # loopback port Tailscale Serve proxies to (not a phone-facing port)
