# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data (large files — don't commit to git)
data/raw/
data/processed/
data/models/*.pt
data/models/*.pth
data/models/*.onnx
data/models/*.task

# Third-party reference corpora (GolfDB and anything like it). Kept out of git for licensing
# as much as size: the upstream annotations and per-clip rows keyed to named tour players are
# third-party data we redistribute nothing of. Only *aggregate* statistics are committed, and
# those live in the package at src/golf_coach/analysis/benchmarks/. See ADR-012.
data/reference/

# Spike frame dumps. Large, and regenerate in a minute from footage the repo already has
# (`spikes/club-head-detectability/probe.py frames`). The findings are committed, the pixels
# are not — same rule as data/.
spikes/*/frames/

# Database
*.db

# Node
node_modules/
frontend/build/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp

# Claude Code: shared settings are tracked in .claude/settings.json; the .local. file is
# per-machine (scratchpad paths, one-off approvals) and is nobody else's business.
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Environment
.env
