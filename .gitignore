# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data (large files — don't commit to git)
data/raw/
data/processed/
data/models/*.pt
data/models/*.pth
data/models/*.onnx
data/models/*.task

# Third-party reference corpora (GolfDB and anything like it). Kept out of git for licensing
# as much as size: the upstream annotations and per-clip rows keyed to named tour players are
# third-party data we redistribute nothing of. Only *aggregate* statistics are committed, and
# those live in the package at src/golf_coach/analysis/benchmarks/. See ADR-012.
data/reference/

# Spike frame dumps. Large, and regenerate in a minute from footage the repo already has
# (`spikes/club-head-detectability/probe.py frames`). The findings are committed, the pixels
# are not — same rule as data/.
spikes/*/frames/

# Database
*.db

# Node
node_modules/
frontend/build/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp

# Claude Code: shared settings are tracked in .claude/settings.json; the .local. file is
# per-machine (scratchpad paths, one-off approvals) and is nobody else's business.
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Environment. `.env*` rather than the bare `.env`: this repo is public, and the one-filename
# rule only ever covered the file people are careful with. A `cp .env .env.bak` before an edit,
# or an editor leaving `.env.save`, would have committed a live token — the file is *not* the
# thing that needs protecting, the shape of its name is. The negation keeps the template tracked.
.env*
!.env.example

# Keys and certificates, whatever they end up being called. Nothing in the repo matches these
# today; they are here so the first one to appear is ignored before anyone thinks about it.
*.key
*.pem
*.pfx
*.p12
